<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elegance Couture</title>
    <link rel="stylesheet" href="/css/eleganceCouture.css">
    <script src="/js/eleganceCouture.js" defer></script>
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="brand">
                <span class="brand-mark">EC</span>
                <span class="brand-text">
                    <strong>Elegance Couture</strong>
                    <small>Creations sur mesure et retouches</small>
                </span>
            </a>

            <nav class="main-nav" aria-label="Navigation principale">
                <a href="/accueil">Accueil</a>
                <a href="/service">Service</a>
                <a href="/vitrine">Vitrine</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container hero-grid">
                <div class="hero-copy">
                    <p class="eyebrow">Atelier artisanal a Mayotte</p>
                    <h1>Des tenues pensees pour mettre votre silhouette et votre occasion en valeur.</h1>
                    <p class="hero-text">
                        Elegance Couture realise des creations feminines, des retouches soignes
                        et des tenues d'evenement avec un accompagnement simple et personnalise.
                    </p>

                    <div class="hero-actions">
                        <a href="/service#contact" class="btn btn-primary">Prendre contact</a>
                        <a href="/accueil" class="btn btn-secondary">Voir l'accueil</a>
                    </div>

                    <ul class="hero-points">
                        <li>Creation sur mesure</li>
                        <li>Retouches de precision</li>
                        <li>Conseil style pour mariage et ceremonie</li>
                    </ul>
                </div>

                <div class="hero-visual">
                    <img src="/assets/images/tenue%20bleue.jpg" alt="Creation Elegance Couture">
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <a href="/vitrine" class="apercu-link">
                    <article class="apercu">
                        <img src="/assets/images/img%20accueil.png" alt="Apercu des creations Elegance Couture">
                        <div class="apercu-text">
                            <p class="eyebrow">Vitrine photo</p>
                            <h2>Explorer les pieces, les matieres et les silhouettes de l'atelier.</h2>
                            <p>La vitrine rassemble les tenues de ceremonie, les modeles enfant et les pieces plus habillees.</p>
                            <span class="inline-link">Ouvrir la vitrine complete</span>
                        </div>
                    </article>
                </a>
            </div>
        </section>

    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>Elegance Couture</p>
            <p>Creations sur mesure, retouches et conseil style</p>
        </div>
    </footer>

    <div id="lightbox" class="lightbox" aria-hidden="true">
        <button class="close" type="button" aria-label="Fermer">&times;</button>
        <img class="lightbox-content" id="lightbox-img" src="" alt="">
        <p id="caption"></p>
    </div>
</body>
</html>
