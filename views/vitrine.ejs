<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vitrine - Elegance Couture</title>
    <link rel="stylesheet" href="/css/vitrine.css">
</head>
<body>
    <header class="vitrine-header">
        <div class="container header-row">
            <div>
                <p class="eyebrow">Vitrine photo</p>
                <h1>Des creations pensees pour bien vivre sur petit et grand ecran.</h1>
            </div>

            <nav aria-label="Navigation vitrine">
                <a href="/">Retour au site</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="section">
            <div class="container">
                <div class="carousel-shell">
                    <button id="prevBtn" class="carousel-btn" type="button" aria-label="Precedent">&#10094;</button>

                    <div class="carousel-track" id="ring">
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20blanche/blanche1.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20dore/doree.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20dore/doree2.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20dore/doree3.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20dore/doree4.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/argent1.jpeg')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/argent2.jpeg')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/argent3.jpeg')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20rouge/rouge.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20rouge/rouge2.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20enfant/enfant.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20maron/m1.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20maron/m2.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20maron/m3.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20maron/m4.png')"></div>
                        </article>
                        <article class="look-card">
                            <div class="img" style="background-image:url('/assets/images/tenu%20maron/m5.png')"></div>
                        </article>
                    </div>

                    <button id="nextBtn" class="carousel-btn" type="button" aria-label="Suivant">&#10095;</button>
                </div>
            </div>
        </section>
    </main>

    <div id="pleinEcran" aria-hidden="true">
        <div id="pleinEcranImg"></div>
    </div>

    <script src="/js/vitrine.js"></script>
</body>
</html>
